{
  "$type": "EdgeCVSet",
  "$node-dest": "node-dell-1",
  "$group": "config",
  "$producer": "node-dell-1",
  "$user": "admin",
  "$when": "2026-09-29T23:00:00Z",
  "fields": {
    "gateway_node_id": "node-dell-1",
    "plugin_id": "bindu-edge-cv-plugin",
    "global_settings": {
      "inference_engine": "onnx_yolox_nano",
      "confidence_threshold": 0.55,
      "worker_pool_size": 2,
      "frame_cadence_fps": 1,
      "classes_of_interest": [
        "person"
      ],
      "color_extraction_enabled": true,
      "snapshot_storage_provider": "minio_local",
      "snapshot_bucket": "cv-snapshots"
    },
    "cameras": [
      {
        "camera_id": "cam-tapo-room",
        "station_id": "room-ambient-overview",
        "name": "TP-Link Tapo IP Camera at Angle (RTSP TCP/IP)",
        "source_kind": "tcp_ip",
        "source_ref": "rtsp://binducv:abubindu@192.168.12.177:554/stream2",
        "rtsp_transport": "tcp",
        "adjacent_camera_ids": [],
        "min_presence_frames": 2,
        "lost_debounce_frames": 3,
        "enabled": true
      }
    ]
  }
}
