{
  "$type": "EdgeCVSet",
  "$id": "msg-edge-cv-set-001",
  "$group": "config",
  "$producer": "root",
  "$user": "admin",
  "$when": "2026-09-28T12:00:00Z",
  "fields": {
    "gateway_node_id": "root",
    "plugin_id": "bindu-edge-cv-plugin",
    "global_settings": {
      "inference_engine": "onnx_yolox_nano",
      "confidence_threshold": 0.5,
      "worker_pool_size": 2,
