{
  "$type": "MessageTypeSet",
  "$group": "mesh",
  "$producer": "root",
  "$user": "console",
  "$when": "2026-11-07T12:00:00Z",
  "fields": {
    "message_types": [
      {
        "name": "MachineVibrationSample",
        "description": "1-minute edge vibration and operating state sample from non-invasive bolt-on triaxial BLE beacon",
        "emoji": "🚜",
        "version": "1.0.0",
        "persist": true,
        "retentionMode": "count",
        "retentionValue": 100,
        "routing": [
          "local",
          "parent"
        ],
        "schema": {
          "type": "object",
          "properties": {
            "machine_id": {
              "type": "string",
              "description": "Unique heavy machinery identifier (e.g. CAT-390F-01)"
            },
            "machine_model": {
              "type": "string",
              "description": "OEM model and description (e.g. CAT 390F Hydraulic Excavator)"
            },
            "machine_type": {
              "type": "string",
              "enum": [
                "EXCAVATOR",
                "HAUL_TRUCK",
                "ROCK_BREAKER",
                "DOZER",
                "WHEEL_LOADER"
              ],
              "description": "Category of heavy equipment"
            },
            "operating_state": {
              "type": "string",
              "enum": [
                "OFF",
                "IDLE",
                "WORKING"
              ],
              "description": "Classified operational state from vibration dynamics"
            },
            "vibration_rms": {
              "type": "number",
              "description": "Root Mean Square acceleration in g"
            },
            "peak_g": {
              "type": "number",
              "description": "Peak instantaneous acceleration in g-force"
            },
            "crest_factor": {
              "type": "number",
              "description": "Ratio of Peak G to RMS acceleration (peak_g / vibration_rms)"
            },
            "kurtosis": {
              "type": "number",
              "description": "Statistical peakedness of vibration distribution (Gaussian = 3.0)"
            },
            "sample_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "Physical observation timestamp in RFC3339 format"
            },
            "battery_millivolts": {
              "type": "integer",
              "description": "Beacon battery voltage in millivolts (e.g. 3600)"
            },
            "beacon_id": {
              "type": "string",
              "description": "BLE beacon hardware MAC / serial ID"
            },
            "ingest_mode": {
              "type": "string",
              "enum": [
                "REALTIME",
                "DRIVE_BY_BURST"
              ],
              "description": "Ingestion delivery transport"
            }
          },
          "required": [
            "machine_id",
            "operating_state",
            "vibration_rms",
            "peak_g",
            "crest_factor",
            "kurtosis",
            "sample_timestamp"
          ]
        }
      },
      {
        "name": "MachineVibrationBatchIngress",
        "description": "Drive-by burst packet holding circular buffer of 1-minute samples collected opportunistically",
        "emoji": "📦",
        "version": "1.0.0",
        "persist": true,
        "retentionMode": "count",
        "retentionValue": 20,
        "routing": [
          "local",
          "parent"
        ],
        "schema": {
          "type": "object",
          "properties": {
            "machine_id": {
              "type": "string",
              "description": "Unique heavy machinery identifier"
            },
            "beacon_id": {
              "type": "string",
              "description": "BLE beacon hardware ID"
            },
            "gateway_id": {
              "type": "string",
              "description": "Drive-by collector vehicle or stationary gateway identifier"
            },
            "burst_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the drive-by gateway acquired the burst"
            },
            "batch_count": {
              "type": "integer",
              "description": "Number of sample records contained in this burst"
            },
            "samples": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Array of chronologically ordered 1-minute vibration samples"
            }
          },
          "required": [
            "machine_id",
            "gateway_id",
            "burst_timestamp",
            "batch_count",
            "samples"
          ]
        }
      },
      {
        "name": "EquipmentAbuseIncident",
