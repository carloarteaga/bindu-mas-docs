        "emoji": "💥",
        "version": "1.0.0",
        "persist": true,
        "retentionMode": "count",
        "retentionValue": 50,
        "routing": [
          "local",
          "parent"
        ],
        "schema": {
          "type": "object",
          "properties": {
            "incident_id": {
              "type": "string",
              "description": "Unique incident identifier"
            },
            "machine_id": {
              "type": "string",
              "description": "Heavy equipment identifier"
            },
            "machine_model": {
              "type": "string",
              "description": "Equipment model"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "Incident timestamp"
            },
            "peak_g": {
              "type": "number",
              "description": "Measured peak g-force that breached the safety threshold"
            },
            "vibration_rms": {
              "type": "number",
              "description": "Baseline RMS at incident"
            },
            "crest_factor": {
              "type": "number",
              "description": "Crest factor at incident"
            },
            "abuse_severity": {
              "type": "string",
              "enum": [
                "WARNING",
                "SEVERE",
                "CRITICAL"
              ],
              "description": "Categorized severity of abusive event"
            },
            "incident_type": {
              "type": "string",
              "description": "Classification of abusive event"
            },
            "recommendation": {
              "type": "string",
              "description": "Immediate operator or supervisor instruction"
            }
          },
          "required": [
            "incident_id",
            "machine_id",
            "timestamp",
            "peak_g",
            "abuse_severity",
            "incident_type"
          ]
        }
      },
      {
        "name": "BearingDefectSuspected",
        "description": "Early-stage mechanical bearing degradation flagged by dual Crest Factor + Kurtosis CEL gating",
        "emoji": "⚠️",
        "version": "1.0.0",
        "persist": true,
        "retentionMode": "count",
        "retentionValue": 50,
        "routing": [
          "local",
          "parent"
        ],
        "schema": {
          "type": "object",
          "properties": {
            "alert_id": {
              "type": "string",
              "description": "Unique defect alert identifier"
            },
            "machine_id": {
              "type": "string",
              "description": "Heavy equipment identifier"
            },
            "machine_model": {
              "type": "string",
              "description": "Equipment model"
            },
            "component_monitored": {
              "type": "string",
              "description": "Mechanical component under surveillance (e.g. Main Hydraulic Pump)"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "Detection timestamp"
            },
            "crest_factor": {
              "type": "number",
              "description": "Calculated Crest Factor triggering the alert"
            },
            "kurtosis": {
              "type": "number",
              "description": "Calculated Kurtosis triggering the alert"
            },
            "vibration_rms": {
              "type": "number",
              "description": "Current RMS vibration level"
            },
            "peak_g": {
              "type": "number",
              "description": "Current peak g-force"
            },
            "defect_stage": {
              "type": "string",
              "enum": [
                "STAGE_1_MICRO_PITTING",
                "STAGE_2_INCIPIENT_SPALLING",
                "STAGE_3_SEVERE_DEFECT"
              ],
              "description": "Estimated bearing defect stage according to ISO 13373 vibration standards"
            }
          },
          "required": [
            "alert_id",
            "machine_id",
            "component_monitored",
            "timestamp",
            "crest_factor",
            "kurtosis",
            "defect_stage"
          ]
        }
      },
      {
        "name": "PredictiveMaintenanceDiagnosis",
        "description": "Cognitive diagnostic work order emitted by Semantic AI Reactor with dynamic context hydration",
        "emoji": "🛠️",
        "version": "1.0.0",
        "persist": true,
        "retentionMode": "count",
        "retentionValue": 50,
        "routing": [
          "local",
          "parent"
        ],
        "schema": {
          "type": "object",
          "properties": {
            "diagnosis_id": {
              "type": "string",
              "description": "Unique diagnostic work order identifier"
            },
            "machine_id": {
              "type": "string",
              "description": "Heavy equipment identifier"
            },
            "machine_model": {
              "type": "string",
              "description": "Equipment model"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "Diagnosis generation timestamp"
            },
            "component": {
              "type": "string",
              "description": "Diagnosed sub-system or component"
            },
            "diagnosed_failure_mode": {
              "type": "string",
              "description": "Specific failure mode identified from historical vibration drift"
            },
            "defect_severity": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH",
                "CRITICAL"
              ],
              "description": "Overall operational risk severity"
            },
            "estimated_remaining_useful_life_hours": {
              "type": "integer",
              "description": "Estimated remaining operating hours before catastrophic failure (RUL)"
            },
            "confidence_score": {
              "type": "number",
              "description": "Model confidence between 0.0 and 1.0"
            },
            "recommended_action": {
              "type": "string",
              "description": "Prescriptive corrective action for pit mechanics"
            },
            "work_order_priority": {
              "type": "string",
              "enum": [
                "ROUTINE",
                "NEXT_SHIFT",
                "IMMEDIATE_STOP"
              ],
              "description": "Priority for dispatching maintenance crew"
            }
          },
          "required": [
            "diagnosis_id",
            "machine_id",
            "timestamp",
            "component",
            "diagnosed_failure_mode",
            "defect_severity",
            "estimated_remaining_useful_life_hours",
            "confidence_score",
            "recommended_action",
            "work_order_priority"
          ]
        }
      }
    ]
  }
}
